# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

# Microsoft Office & Project temporary / lock files
~$*
*.tmp
*.bak

# Power BI Desktop temporary files
*.pbix.temp

# Python / Scripts temporary files
__pycache__/
*.py[cod]
*$py.class
*.log
.env
venv/
env/

# Editor / IDE settings
.vscode/
.idea/

